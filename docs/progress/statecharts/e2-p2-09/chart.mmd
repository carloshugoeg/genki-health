  class s15 pink
  class s18 blue
  class s19 blue
  class s23 teal
  class s23 bugPath
  class s26 teal
  class s26 breaks
  class s27 teal
  class s27 breaks
  class s27 bugPath
  class s31 orange
  class s32 orange
  class s32 bugPath
  class s35 orange
  class s36 orange
  class s39 orange
  class s40 orange
  class s40 bugPath
