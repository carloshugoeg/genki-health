# Copy to .env for local runs. Never commit .env.

NODE_ENV=development
API_HOST=127.0.0.1
API_PORT=3000

# Auth (Carlos 2026-10-19). Required for the API. Min 16 characters.
JWT_SECRET=genki-dev-jwt-secret-change-me

# System-of-record identity store (Hospital PostgreSQL) — real driver wiring later.
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=genki_hospital
POSTGRES_USER=genki
POSTGRES_PASSWORD=genki_dev_only

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=genki_pediatrico
MYSQL_USER=genki
MYSQL_PASSWORD=genki_dev_only

MONGODB_URI=mongodb://127.0.0.1:27017/genki_laboratorio

# Firebase emulator only in Phase 0.
FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
FIREBASE_PROJECT_ID=genki-health-demo
