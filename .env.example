# Plantilla de configuración local. `bash levantar.sh` crea `.env` a partir de este archivo
# y rellena los secretos con valores aleatorios generados en tu máquina.
# Nunca pongas valores secretos aquí: este archivo se versiona.
# Marca que identifica un .env creado para la entrega (motores en Docker + emulador de Firestore).
GENKI_ENTREGA=1

NODE_ENV=development
GENKI_MODE=engines
API_HOST=127.0.0.1
API_PORT=3000
WEB_PORT=5173

# Secretos: vacíos en el repo. levantar.sh los genera (SEED_PASSWORD = contraseña de los usuarios demo).
JWT_SECRET=
SEED_PASSWORD=
POSTGRES_PASSWORD=
MYSQL_ROOT_PASSWORD=
MYSQL_PASSWORD=
MONGO_ROOT_PASSWORD=
MONGO_APP_PASSWORD=
MONGO_REPORT_PASSWORD=
APP_DB_PASSWORD=
IDENTITY_DB_PASSWORD=
REPORT_DB_PASSWORD=

# Motores en Docker (infra/entrega/docker-compose.yml). Puertos poco comunes para no chocar
# con instalaciones locales; si alguno está ocupado, cámbialo aquí y vuelve a ejecutar levantar.sh.
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=55432
POSTGRES_DB=genki_test_hospital
POSTGRES_USER=genki
MYSQL_HOST=127.0.0.1
MYSQL_PORT=53306
MYSQL_DATABASE=genki_test_pediatrico
MYSQL_USER=genki
MONGO_PORT=57017
MONGO_DATABASE=genki_test_laboratorio
FIRESTORE_PORT=58080

# Firestore en modo emulador: proyecto demo-*, no necesita credenciales de Google.
FIRESTORE_MODE=emulator
GCLOUD_PROJECT=demo-genki-health
FIREBASE_PROJECT_ID=demo-genki-health
AGENDA_FIREBASE_PROJECT_ID=demo-genki-health
GOOGLE_APPLICATION_CREDENTIALS=

# Derivadas: levantar.sh las recalcula en cada arranque a partir de los valores de arriba.
FIRESTORE_EMULATOR_HOST=
PG_ADMIN_URL=
MYSQL_ADMIN_URL=
MONGO_ADMIN_URI=
DATABASE_URL=
AUTH_DATABASE_URL=
MYSQL_URL=
MONGODB_URI=
AGENDA_POSTGRES_URL=
AGENDA_MYSQL_URL=
AGENDA_MONGODB_URL=
