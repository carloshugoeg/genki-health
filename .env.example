# Copy to .env for local runs. Never commit .env.
# Auth / JWT / password policy are needs-human — leave blank until Carlos decides.

NODE_ENV=development
API_HOST=127.0.0.1
API_PORT=3000

# System-of-record identity store (Hospital PostgreSQL) — wiring deferred.
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=genki_hospital
POSTGRES_USER=genki
POSTGRES_PASSWORD=genki_dev_only

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=genki_pediatrico
MYSQL_USER=genki
MYSQL_PASSWORD=genki_dev_only

MONGODB_URI=mongodb://127.0.0.1:27017/genki_laboratorio

# Firebase emulator only in Phase 0. Real project is out of scope until demo needs it.
FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
FIREBASE_PROJECT_ID=genki-health-demo

# needs-human: JWT secret, claims shape, session TTL — do not invent.
# JWT_SECRET=
