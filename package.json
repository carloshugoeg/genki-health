{
  "name": "genki-health",
  "private": true,
  "type": "module",
  "workspaces": [
    "server",
    "web",
    "shared"
  ],
  "scripts": {
    "build": "npm run build -w @genki/shared && npm run build -w @genki/server && npm run build -w @genki/web",
    "typecheck": "npm run typecheck -w @genki/shared && npm run typecheck -w @genki/server && npm run typecheck -w @genki/web",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "npm run test -w @genki/shared && npm run test -w @genki/server && npm run test -w @genki/web",
    "test:protocol": "node --test scripts/test/*.test.mjs",
    "test:contract-red": "bash scripts/expect-contract-red.sh",
    "db:bootstrap": "tsx --import dotenv/config scripts/db-bootstrap.ts",
    "db:migrate": "tsx --import dotenv/config scripts/db-migrate.ts",
    "db:reset:test": "tsx --import dotenv/config scripts/db-migrate.ts --reset",
    "firebase:start": "firebase emulators:start --only firestore --project demo-genki-health --config infra/firebase/firebase.json",
    "depcruise": "dependency-cruiser --config .dependency-cruiser.cjs server/src",
    "validate": "bash scripts/validate.sh",
    "db:seed": "tsx --import dotenv/config scripts/seed.ts",
    "db:setup:all": "tsx --import dotenv/config scripts/db-setup-all.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.12.0",
    "@firebase/rules-unit-testing": "4.0.1",
    "@types/node": "^22.7.5",
    "@vitest/coverage-v8": "2.1.2",
    "dependency-cruiser": "^16.4.2",
    "dotenv": "16.4.5",
    "eslint": "^9.12.0",
    "eslint-config-prettier": "^9.1.0",
    "firebase-tools": "14.22.0",
    "playwright": "1.56.1",
    "prettier": "^3.3.3",
    "tsx": "4.19.1",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.8.1",
    "vitest": "^2.1.2"
  },
  "engines": {
    "node": ">=20"
  }
}
