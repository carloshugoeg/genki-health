    "firebase-admin": "13.0.0",
    "jose": "^6.2.12",
    "mongodb": "6.10.0",
    "mysql2": "3.11.3",
    "pg": "8.13.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/pg": "8.11.10",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3",
    "vitest": "^2.1.2"
  }
}
