// Chen detallado. Sección 6.4.4. Hospitalización y procedimientos (Hospital general).
// Símbolos: ver clave Graphviz en README.md (sección 6.1).
// CAMA débil de SERVICIO (clave parcial codigo). NOTA_EVOLUCION débil de ADMISION.
// Notas append-only: corrección = nota nueva; sin columna de autorreferencia (needs-human #4).
// PROCEDIMIENTO cuelga de ADMISION o de CONSULTA (ambas parciales; no se fuerzan las dos).
// Relación Incluye / Clasifica alineadas con rel-hospitalizacion.mmd (sección 6.2 no las nombra).
digraph chen_6_4_4 {
  rankdir=LR;
  splines=true;
  overlap=false;
  nodesep=0.35;
  ranksep=0.55;
  graph [
    fontname="Helvetica",
    label="6.4.4 Hospitalización y procedimientos (Hospital general)\nNOTA_EVOLUCION: registros inmutables; corrección = nota nueva (sin autorreferencia)",
    labelloc=t,
    fontsize=13
  ];
  node [fontname="Helvetica", fontsize=10];
  edge [fontname="Helvetica", fontsize=9, arrowhead=none];

  // Entidades fuertes
  node [shape=box, style=solid, peripheries=1];
  SERVICIO;
  ADMISION;
  CONSULTA;
  PROCEDIMIENTO;
  CATALOGO_PROCEDIMIENTO;

  // Entidades débiles
  node [shape=box, peripheries=2];
  CAMA;
  NOTA_EVOLUCION;

  // Relaciones
  node [shape=diamond, style=solid, peripheries=1, height=0.7, width=1.1];
  Aloja [label="Aloja"];
  Incluye_adm [label="Incluye"];
  Incluye_con [label="Incluye"];
  Clasifica [label="Clasifica"];

  // Relaciones identificadoras
  node [shape=diamond, peripheries=2, height=0.7, width=1.2];
  Contiene [label="Contiene"];
  Documenta [label="Documenta"];

  // Atributos
  node [shape=ellipse, style=solid, peripheries=1, width=0, height=0];

  // SERVICIO (sección 5.2)
  id_servicio [label=<<U>id_servicio</U>>];
  nombre_serv [label="nombre"];
  piso;
  activo_serv [label="activo"];

  // CAMA — clave parcial codigo; tipo_cama y codigo_servicio de sección 5.2
  codigo_cama [label=<<U>codigo</U>>, style=dashed];
  tipo_cama;
  codigo_servicio;
  estado_cama [label="estado"];

  // ADMISION (sección 5.2); FKs como atributos cuando la relación no está en 6.2/6.4.4
  id_admision [label=<<U>id_admision</U>>];
  id_expediente;
  id_consulta_origen;
  id_diagnostico_ingreso;
  id_diagnostico_egreso;
  tipo_ingreso;
  fecha_hora_ingreso;
  fecha_hora_egreso;
  condicion_egreso;
  estado_adm [label="estado"];

  // NOTA_EVOLUCION — débil; sin self-ref (needs-human #4)
  fecha_hora_nota [label=<<U>fecha_hora</U>>, style=dashed];
  id_profesional_nota [label="id_profesional"];
  contenido;
  turno;

  // CONSULTA (contexto: el procedimiento puede colgar de ella)
  id_consulta [label=<<U>id_consulta</U>>];

  // CATALOGO_PROCEDIMIENTO
  codigo_procedimiento [label=<<U>codigo_procedimiento</U>>];
  nombre_cat [label="nombre"];
  categoria;
  duracion_estimada_min;

  // PROCEDIMIENTO
  id_procedimiento [label=<<U>id_procedimiento</U>>];
  id_profesional_proc [label="id_profesional"];
  fecha_hora_proc [label="fecha_hora"];
  sala;
  hallazgos;
  complicaciones;

  // SERVICIO – Contiene – CAMA (identificadora 1:N; cama con participación total)
  SERVICIO -> Contiene [penwidth=1, headlabel="1"];
  Contiene -> CAMA [penwidth=3, taillabel="N"];

  // CAMA – Aloja – ADMISION (1:N; admisión total: toda admisión tiene cama)
  CAMA -> Aloja [penwidth=1, headlabel="1"];
  Aloja -> ADMISION [penwidth=3, taillabel="N"];

  // ADMISION – Documenta – NOTA_EVOLUCION (identificadora 1:N; nota total)
  ADMISION -> Documenta [penwidth=1, headlabel="1"];
  Documenta -> NOTA_EVOLUCION [penwidth=3, taillabel="N"];

  // ADMISION – Incluye – PROCEDIMIENTO (parcial en ambos: no toda admisión tiene procedimiento)
  ADMISION -> Incluye_adm [penwidth=1, headlabel="1"];
  Incluye_adm -> PROCEDIMIENTO [penwidth=1, taillabel="N"];

  // CONSULTA – Incluye – PROCEDIMIENTO (parcial; alternativa a la admisión, no se fuerzan ambas)
  CONSULTA -> Incluye_con [penwidth=1, headlabel="1"];
  Incluye_con -> PROCEDIMIENTO [penwidth=1, taillabel="N"];

  // CATALOGO_PROCEDIMIENTO – Clasifica – PROCEDIMIENTO (1:N; procedimiento total)
  CATALOGO_PROCEDIMIENTO -> Clasifica [penwidth=1, headlabel="1"];
  Clasifica -> PROCEDIMIENTO [penwidth=3, taillabel="N"];

  // Atributos → SERVICIO
  id_servicio -> SERVICIO;
  nombre_serv -> SERVICIO;
  piso -> SERVICIO;
  activo_serv -> SERVICIO;

  // Atributos → CAMA
  codigo_cama -> CAMA;
  tipo_cama -> CAMA;
  codigo_servicio -> CAMA;
  estado_cama -> CAMA;

  // Atributos → ADMISION
  id_admision -> ADMISION;
  id_expediente -> ADMISION;
  id_consulta_origen -> ADMISION;
  id_diagnostico_ingreso -> ADMISION;
  id_diagnostico_egreso -> ADMISION;
  tipo_ingreso -> ADMISION;
  fecha_hora_ingreso -> ADMISION;
  fecha_hora_egreso -> ADMISION;
  condicion_egreso -> ADMISION;
  estado_adm -> ADMISION;

  // Atributos → NOTA_EVOLUCION
  fecha_hora_nota -> NOTA_EVOLUCION;
  id_profesional_nota -> NOTA_EVOLUCION;
  contenido -> NOTA_EVOLUCION;
  turno -> NOTA_EVOLUCION;

  // Atributos → CONSULTA (solo la clave; el resto está en 6.4.2)
  id_consulta -> CONSULTA;

  // Atributos → CATALOGO_PROCEDIMIENTO
  codigo_procedimiento -> CATALOGO_PROCEDIMIENTO;
  nombre_cat -> CATALOGO_PROCEDIMIENTO;
  categoria -> CATALOGO_PROCEDIMIENTO;
  duracion_estimada_min -> CATALOGO_PROCEDIMIENTO;

  // Atributos → PROCEDIMIENTO
  id_procedimiento -> PROCEDIMIENTO;
  id_profesional_proc -> PROCEDIMIENTO;
  fecha_hora_proc -> PROCEDIMIENTO;
  sala -> PROCEDIMIENTO;
  hallazgos -> PROCEDIMIENTO;
  complicaciones -> PROCEDIMIENTO;
}
